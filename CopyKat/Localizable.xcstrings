    "Clear clipboard history?": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klembordgeschiedenis wissen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablageverlauf löschen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer l'historique du presse-papiers ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar el historial del portapapeles?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellare la cronologia degli appunti?"
          }
        },
        "pt-PT": {
