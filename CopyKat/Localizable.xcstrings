            "state": "translated",
            "value": "Добро пожаловать в CopyKat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 CopyKat"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎使用 CopyKat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyKatへようこそ"
          }
        },
        "ko": {
          "stringUnit": {
