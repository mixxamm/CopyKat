            "value" : "Bir şey kopyalayıp aşağıdaki Yapıştır'a dokunun ya da herhangi bir uygulamadan CopyKat'e paylaşın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопіюйте щось і торкніться «Вставити» нижче, або поділіться цим із CopyKat з будь-якого застосунку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
