    "All items except pinned ones are removed. This cannot be undone.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle items behalve vastgezette worden verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Objekte außer den angehefteten werden entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les éléments à l'exception des éléments épinglés sont supprimés. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan todos los elementos excepto los fijados. Esta acción no se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli elementi tranne quelli bloccati vengono rimossi. L'operazione non può essere annullata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os itens exceto os fixados são removidos. Esta ação não pode ser anulada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie elementy z wyjątkiem przypiętych zostaną usunięte. Tej czynności nie można cofnąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі елементи, крім закріплених, буде вилучено. Цю дію не можна скасувати."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate elementele, cu excepția celor fixate, sunt eliminate. Această acțiune nu poate fi anulată."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla objekt utom fästa tas bort. Detta kan inte ångras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все элементы, кроме закреплённых, будут удалены. Это действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除已置顶的项目外，其余项目都将被移除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除了已置頂的項目外，其餘項目都會被移除。此操作無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めされた項目を除くすべての項目が削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 항목을 제외한 모든 항목이 제거됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenenler dışındaki tüm öğeler kaldırılır. Bu işlem geri alınamaz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة جميع العناصر باستثناء المثبّتة. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन किए गए आइटम को छोड़कर बाकी सभी आइटम हटा दिए जाते हैं। इसे पूर्ववत नहीं किया जा सकता।"
          }
        }
      }
    },
