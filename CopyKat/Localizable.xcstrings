    "On the clipboard. Press and hold a text field, then Paste." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الحافظة. اضغط مطولًا على حقل نص ثم اختر «لصق»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Zwischenablage. Halte ein Textfeld gedrückt und wähle Einsetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el portapapeles. Mantén pulsado un campo de texto y elige Pegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le presse-papiers. Maintenez un champ de texte, puis Coller."
          }
        },
        "hi" : {
          "stringUnit" : {
