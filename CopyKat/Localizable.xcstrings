    "Turn on CopyKat under Keyboards to paste from your history wherever you type. It works without Full Access." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل CopyKat ضمن لوحات المفاتيح للصق من سجلّك أينما تكتب. يعمل دون وصول كامل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere CopyKat unter Tastaturen, um überall beim Tippen aus deinem Verlauf einzusetzen. Es funktioniert ohne Vollzugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa CopyKat en Teclados para pegar desde tu historial dondequiera que escribas. Funciona sin acceso total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez CopyKat dans Claviers pour coller depuis votre historique partout où vous tapez. Cela fonctionne sans accès complet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीबोर्ड में CopyKat चालू करें ताकि आप जहाँ भी टाइप करें अपने इतिहास से चिपका सकें। यह पूर्ण पहुँच के बिना काम करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva CopyKat in Tastiere per incollare dalla cronologia ovunque scrivi. Funziona senza accesso completo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードの設定でCopyKatをオンにすると、どこで入力していても履歴からペーストできます。フルアクセスなしで動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드에서 CopyKat을 켜면 입력하는 곳 어디서나 기록에서 붙여넣을 수 있습니다. 전체 접근 권한 없이 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet CopyKat aan onder Toetsenborden om overal waar je typt uit je geschiedenis te plakken. Het werkt zonder volledige toegang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz CopyKat w sekcji Klawiatury, aby wklejać z historii wszędzie tam, gdzie piszesz. Działa bez pełnego dostępu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o CopyKat em Teclados para colar do histórico onde quer que escreva. Funciona sem acesso total."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activează CopyKat la Tastaturi ca să lipești din istoric oriunde scrii. Funcționează fără acces complet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите CopyKat в разделе «Клавиатуры», чтобы вставлять из истории везде, где вы печатаете. Работает без полного доступа."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera CopyKat under Tangentbord för att klistra in från historiken var du än skriver. Det fungerar utan fullständig åtkomst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazdığınız her yerde geçmişinizden yapıştırmak için Klavyeler altında CopyKat'i açın. Tam Erişim olmadan çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть CopyKat у розділі «Клавіатури», щоб вставляти з історії всюди, де ви друкуєте. Працює без повного доступу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“键盘”中开启 CopyKat，即可在任何输入处从历史记录粘贴。无需完全访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「鍵盤」中開啟 CopyKat，即可在任何輸入處從記錄貼上。無需完整取用權限。"
          }
        }
      }
    },
