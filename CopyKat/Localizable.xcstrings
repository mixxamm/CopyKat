          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速貼上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高速ペースト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 붙여넣기"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı yapıştırma"
          }
        },
        "ar": {
