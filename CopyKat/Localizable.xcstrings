    "Adds h, j, k and l alongside the arrow keys. They only move the highlight while the search field is empty, so searching stays possible." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف h وj وk وl إلى جانب مفاتيح الأسهم. تحرّك التحديد فقط ما دام حقل البحث فارغًا، حتى يظل البحث ممكنًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ergänzt die Pfeiltasten um h, j, k und l. Sie bewegen die Markierung nur, solange das Suchfeld leer ist, damit die Suche weiter funktioniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade h, j, k y l junto a las flechas. Solo mueven la selección mientras el campo de búsqueda está vacío, para que buscar siga siendo posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute h, j, k et l en plus des flèches. Ces touches ne déplacent la sélection que tant que le champ de recherche est vide, pour que la recherche reste possible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तीर कुंजियों के साथ h, j, k और l जोड़ता है। ये केवल तब चयन बदलते हैं जब खोज फ़ील्ड खाली हो, ताकि खोजना संभव बना रहे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge h, j, k e l accanto alle frecce. Spostano la selezione solo finché il campo di ricerca è vuoto, così la ricerca resta possibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "矢印キーに加えて h、j、k、l を使えます。検索フィールドが空のあいだだけ選択を動かすので、検索はそのまま行えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화살표 키에 h, j, k, l을 더합니다. 검색 필드가 비어 있을 때만 선택을 옮기므로 검색은 그대로 할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt h, j, k en l toe naast de pijltjestoetsen. Ze verplaatsen de markering alleen zolang het zoekveld leeg is, zodat zoeken mogelijk blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje h, j, k i l obok strzałek. Przesuwają zaznaczenie tylko wtedy, gdy pole wyszukiwania jest puste, dzięki czemu wyszukiwanie nadal działa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acrescenta h, j, k e l às setas. Só movem a seleção enquanto o campo de pesquisa estiver vazio, para que a pesquisa continue possível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă h, j, k și l pe lângă săgeți. Mută selecția doar cât timp câmpul de căutare este gol, astfel încât căutarea să rămână posibilă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет h, j, k и l к клавишам со стрелками. Они перемещают выделение, только пока поле поиска пусто, чтобы поиск оставался возможным."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till h, j, k och l vid sidan av piltangenterna. De flyttar markeringen bara så länge sökfältet är tomt, så att sökning fortfarande går."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ok tuşlarının yanına h, j, k ve l ekler. Seçimi yalnızca arama alanı boşken taşırlar, böylece arama yapılabilir kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає h, j, k і l до клавіш зі стрілками. Вони переміщують виділення, лише поки поле пошуку порожнє, щоб пошук залишався можливим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在方向键之外加入 h、j、k、l。它们只在搜索栏为空时移动选中项，搜索依然可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在方向鍵之外加入 h、j、k、l。它們只在搜尋欄為空時移動選取項目，搜尋依然可用。"
          }
        }
      }
    },
