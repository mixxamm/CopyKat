          "stringUnit": {
            "state": "translated",
            "value": "खोजने के लिए V को दो बार दबाएं"
          }
        }
      }
    },
    "Fast paste": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snel plakken"
          }
        },
        "de": {
