    "Pinned items are always kept, however old they are.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastgezette items blijven altijd bewaard, hoe oud ze ook zijn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Objekte werden immer aufbewahrt, egal wie alt sie sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments épinglés sont toujours conservés, quel que soit leur âge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos fijados se conservan siempre, sin importar su antigüedad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi bloccati vengono sempre mantenuti, non importa quanto siano vecchi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens fixados são sempre mantidos, independentemente da idade que tenham."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypięte elementy są zawsze zachowywane, bez względu na to, jak są stare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закріплені елементи завжди зберігаються, незалежно від того, наскільки вони старі."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele fixate sunt păstrate întotdeauna, indiferent cât de vechi sunt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fästa objekt behålls alltid, oavsett hur gamla de är."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённые элементы всегда сохраняются, независимо от их возраста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论多旧，置顶项目都会被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論多舊，置頂項目都會被保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留め項目は、どれだけ古くても常に保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 항목은 아무리 오래되어도 항상 보관됩니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenmiş öğeler ne kadar eski olursa olsun her zaman saklanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الاحتفاظ بالعناصر المثبّتة دائمًا، مهما كان عمرها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन किए गए आइटम हमेशा सुरक्षित रहते हैं, चाहे वे कितने भी पुराने क्यों न हों।"
          }
        }
      }
    },
