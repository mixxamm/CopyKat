          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyKat में आपका स्वागत है"
          }
        }
      }
    },
    "Everything you copy is saved: text, images and files. Press ⇧⌘V any time to search your clipboard history.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je kopieert wordt bewaard: tekst, afbeeldingen en bestanden. Druk op elk moment op ⇧⌘V om je klembordgeschiedenis te doorzoeken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was Sie kopieren, wird gespeichert: Text, Bilder und Dateien. Drücken Sie jederzeit ⇧⌘V, um Ihren Zwischenablageverlauf zu durchsuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous copiez est enregistré : texte, images et fichiers. Appuyez à tout moment sur ⇧⌘V pour rechercher dans l'historique de votre presse-papiers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que copias se guarda: texto, imágenes y archivos. Pulsa ⇧⌘V en cualquier momento para buscar en el historial de tu portapapeles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che copi viene salvato: testo, immagini e file. Premi ⇧⌘V in qualsiasi momento per cercare nella cronologia degli appunti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que copia é guardado: texto, imagens e ficheiros. Prima ⇧⌘V a qualquer momento para pesquisar no histórico da área de transferência."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co skopiujesz, jest zapisywane: tekst, obrazy i pliki. Naciśnij ⇧⌘V w dowolnej chwili, aby przeszukać historię schowka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що ви копіюєте, зберігається: текст, зображення й файли. Натисніть ⇧⌘V у будь-який момент, щоб виконати пошук в історії буфера обміну."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce copiezi este salvat: text, imagini și fișiere. Apasă ⇧⌘V oricând pentru a căuta în istoricul clipboardului."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt du kopierar sparas: text, bilder och filer. Tryck på ⇧⌘V när som helst för att söka i din urklippshistorik."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что вы копируете, сохраняется: текст, изображения и файлы. Нажмите ⇧⌘V в любой момент, чтобы выполнить поиск по истории буфера обмена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你复制的所有内容都会被保存：文本、图像和文件。随时按下 ⇧⌘V 即可搜索剪贴板历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你拷貝的所有內容都會被儲存：文字、影像和檔案。隨時按下 ⇧⌘V 即可搜尋剪貼簿記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたものはすべて保存されます。テキスト、画像、ファイルなど。いつでも⇧⌘Vを押してクリップボード履歴を検索できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사하는 모든 항목이 저장됩니다. 텍스트, 이미지, 파일 등입니다. 언제든지 ⇧⌘V를 눌러 클립보드 기록을 검색하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyaladığınız her şey kaydedilir: metin, görsel ve dosyalar. Pano geçmişinizde arama yapmak için istediğiniz zaman ⇧⌘V tuşlarına basın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم حفظ كل ما تنسخه: النصوص والصور والملفات. اضغط على ⇧⌘V في أي وقت للبحث في سجل الحافظة الخاص بك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो कुछ भी कॉपी करते हैं वह सेव हो जाता है: टेक्स्ट, इमेज और फ़ाइलें। अपना क्लिपबोर्ड इतिहास खोजने के लिए कभी भी ⇧⌘V दबाएं।"
          }
        }
      }
    },
    "Paste directly into any app": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak direct in elke app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt in jede App einfügen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez directement dans n'importe quelle app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega directamente en cualquier app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla direttamente in qualsiasi app"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole diretamente em qualquer app"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklejaj bezpośrednio do dowolnej aplikacji"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставляйте напряму в будь-який застосунок"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipește direct în orice aplicație"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in direkt i vilken app som helst"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставляйте напрямую в любое приложение"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接粘贴到任意 App"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接貼到任何 App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのAppにも直接ペースト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 App에 바로 붙여넣기"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir uygulamaya doğrudan yapıştırın"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق مباشرة في أي تطبيق"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी ऐप में सीधे पेस्ट करें"
          }
        }
      }
    },
    "With the Accessibility permission, choosing an item pastes it straight into the app you're working in. Without it, items are only copied.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de toegankelijkheidsmachtiging plak je een gekozen item meteen in de app waarin je werkt. Zonder deze machtiging worden items alleen gekopieerd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Bedienungshilfen-Berechtigung wird ein ausgewähltes Objekt direkt in die App eingefügt, in der Sie gerade arbeiten. Ohne diese werden Objekte nur kopiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec l'autorisation d'accessibilité, le fait de choisir un élément le colle directement dans l'application dans laquelle vous travaillez. Sans elle, les éléments sont seulement copiés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el permiso de Accesibilidad, elegir un elemento lo pega directamente en la app en la que estás trabajando. Sin él, los elementos solo se copian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l'autorizzazione per l'Accessibilità, scegliendo un elemento lo incolli direttamente nell'app in cui stai lavorando. Senza di essa, gli elementi vengono solo copiati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a permissão de Acessibilidade, escolher um item cola-o diretamente na app em que está a trabalhar. Sem ela, os itens são apenas copiados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki uprawnieniu dostępności wybranie elementu wkleja go od razu w aplikacji, w której pracujesz. Bez niego elementy są tylko kopiowane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З дозволом на доступність вибір елемента вставляє його одразу в застосунок, у якому ви працюєте. Без нього елементи лише копіюються."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu permisiunea de accesibilitate, alegerea unui element îl lipește direct în aplicația în care lucrezi. Fără ea, elementele sunt doar copiate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med behörigheten Hjälpmedel klistras ett valt objekt in direkt i appen du arbetar i. Utan den kopieras objekt bara."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С разрешением «Универсальный доступ» выбор элемента вставляет его прямо в приложение, в котором вы работаете. Без него элементы только копируются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获得辅助功能权限后，选择项目会将其直接粘贴到你正在使用的 App 中。如果没有该权限，项目只会被复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取得輔助使用權限後，選擇項目會將其直接貼到你正在使用的 App 中。如果沒有此權限，項目只會被拷貝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ権限があれば、項目を選択すると作業中のAppに直接ペーストされます。権限がない場合、項目はコピーされるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한이 있으면 항목을 선택할 때 현재 작업 중인 App에 바로 붙여넣어집니다. 권한이 없으면 항목이 복사되기만 합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izniyle bir öğe seçmek, onu üzerinde çalıştığınız uygulamaya doğrudan yapıştırır. Bu izin olmadan öğeler yalnızca kopyalanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بفضل إذن إمكانية الوصول، يؤدي اختيار عنصر إلى لصقه مباشرة في التطبيق الذي تعمل فيه. وبدونه، يتم نسخ العناصر فقط."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सेसिबिलिटी अनुमति के साथ, किसी आइटम को चुनने पर वह सीधे उस ऐप में पेस्ट हो जाता है जिस पर आप काम कर रहे हैं। इसके बिना, आइटम केवल कॉपी होते हैं।"
          }
        }
      }
    },
    "Direct paste is enabled": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct plakken is ingeschakeld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktes Einfügen ist aktiviert"
