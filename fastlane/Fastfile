default_platform(:mac)

# Authentication comes from an App Store Connect API key. Set ASC_KEY_ID and
# ASC_ISSUER_ID in your environment; the .p8 itself stays on disk and is never
# committed.
def asc_api_key
  key_id = ENV.fetch("ASC_KEY_ID")
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV["ASC_KEY_PATH"] ||
      File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  )
end

platform :mac do
  desc "Upload texts and screenshots for every language. Does not submit."
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      platform: "osx",
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Regenerate every screenshot from the running app, then upload"
  lane :screenshots do
    sh("../scripts/screenshots/make.sh")
    metadata
  end
end
